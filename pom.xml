<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>edu.ku</groupId>
    <artifactId>book-api</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>book-api</name>
    <description>Library Book Management REST API - LAB-03: PUT and DELETE (Enterprise Web Application Development, Kabul University)</description>

    <properties>
        <!-- The API targets Java 21 (compiled with the release-21 flag). -->
        <java.version>21</java.version>

        <!-- The local JDK is newer than the version managed by Spring Boot 3.5.x,
             so ByteBuddy (used by Mockito) is pinned to a release that knows it.
             Harmless when the build runs on JDK 21. -->
        <byte-buddy.version>1.18.13</byte-buddy.version>
    </properties>

    <dependencies>
        <!-- Web layer: Spring MVC + embedded Tomcat + Jackson (JSON) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- JUnit 5, AssertJ, Spring Test, MockMvc, TestRestTemplate -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Packages the application as an executable jar (java -jar target/...) -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Mockito/ByteBuddy attach an agent at runtime; the flag
                         avoids the "dynamic agent loading" warning on JDK 21+. -->
                    <argLine>-XX:+EnableDynamicAgentLoading</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
